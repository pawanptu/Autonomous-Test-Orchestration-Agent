# ---------------------------------------------------------------------------
# Autonomous Test Orchestration Agent - example environment.
# Copy to .env and fill in. NEVER commit a real .env (see .gitignore).
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
# Free key from https://console.groq.com  (no credit card required).
GROQ_API_KEY=

# Default target used by the Streamlit form and the CLI when no URL is given.
# Any public URL works; this default needs no login.
TARGET_URL=https://books.toscrape.com/

# --- Optional login for the target application ------------------------------
# Use a THROWAWAY TEST ACCOUNT. These values are held in memory for the
# duration of one run, are never logged, never written to a report, never
# embedded in generated tests, and are wiped when the run ends.
# Prefer supplying them in the POST /run body rather than here.
LOGIN_USERNAME=
LOGIN_PASSWORD=
LOGIN_TOKEN=
LOGIN_URL=

# --- Optional fallback provider (free tier) ---------------------------------
# Google exposes an OpenAI-compatible endpoint, so the same client covers it.
GEMINI_API_KEY=
# GEMINI_MODEL_REASONING=gemini-2.0-flash
# GEMINI_MODEL_CODEGEN=gemini-2.0-flash-lite

# --- Model routing ----------------------------------------------------------
# Judgment (coverage gate, risk, defect classification, confidence, synthesis).
MODEL_REASONING=llama-3.3-70b-versatile
# Mechanical plan-to-code translation. Never route codegen to the 70B.
MODEL_CODEGEN=llama-3.1-8b-instant
# Alternative small model if you prefer: openai/gpt-oss-20b

# --- Rate limiting / retries ------------------------------------------------
LLM_MAX_RETRIES=5
LLM_BACKOFF_BASE_S=1.5
LLM_BACKOFF_MAX_S=45
REASONING_MIN_INTERVAL_S=1.2
CODEGEN_MIN_INTERVAL_S=0.35

# Plumbing-only smoke mode: NO network calls, deterministic stub answers.
# Reports produced this way are labelled and are NOT a real agent run.
LLM_OFFLINE_MODE=false

# --- Feature flags ----------------------------------------------------------
ENABLE_PRD_GAP_ANALYSIS=false
ENABLE_INTENT_BIAS=true
ENABLE_PARALLEL_EXECUTION=false
ENABLE_REGRESSION_RADAR=true
ENABLE_VISUAL_DIFF=true

# --- Crawl / execution ------------------------------------------------------
CRAWL_MAX_PAGES=12
CRAWL_MAX_DEPTH=2
HEADLESS=true
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=900
TEST_TIMEOUT_S=90
MAX_PARALLEL_FLOWS=3

# --- Visual regression ------------------------------------------------------
VISUAL_DIFF_THRESHOLD=0.02
VISUAL_PIXEL_TOLERANCE=24

# --- Service ----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO
