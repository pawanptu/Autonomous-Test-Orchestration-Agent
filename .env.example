# ---------------------------------------------------------------------------
# Autonomous Test Orchestration Agent - example environment.
# Copy to .env and fill in. NEVER commit a real .env (see .gitignore).
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
# Free key from https://console.groq.com  (no credit card required).
GROQ_API_KEY=

# Default target used by the Streamlit form and the CLI when no URL is given.
# Any public URL works; this default needs no login.
TARGET_URL=https://books.toscrape.com/

# --- Optional login for the target application ------------------------------
# Use a THROWAWAY TEST ACCOUNT. These values are held in memory for the
# duration of one run, are never logged, never written to a report, never
# embedded in generated tests, and are wiped when the run ends.
# Prefer supplying them in the POST /run body rather than here.
LOGIN_USERNAME=
LOGIN_PASSWORD=
LOGIN_TOKEN=
LOGIN_URL=

# --- Optional fallback provider (free tier) ---------------------------------
# Google exposes an OpenAI-compatible endpoint, so the same client covers it.
GEMINI_API_KEY=
# GEMINI_MODEL_REASONING=gemini-2.0-flash
# GEMINI_MODEL_CODEGEN=gemini-2.0-flash-lite

# --- Model routing ----------------------------------------------------------
# Judgment (coverage gate, risk, defect classification, confidence, synthesis).
MODEL_REASONING=openai/gpt-oss-120b
# Mechanical plan-to-code translation. Never route codegen to the 70B.
MODEL_CODEGEN=openai/gpt-oss-20b
# The llama-3.3-70b / llama-3.1-8b models were decommissioned by Groq.

# --- Rate limiting / retries ------------------------------------------------
LLM_MAX_RETRIES=5
LLM_BACKOFF_BASE_S=1.5
LLM_BACKOFF_MAX_S=45
REASONING_MIN_INTERVAL_S=1.2
CODEGEN_MIN_INTERVAL_S=0.35

# Plumbing-only smoke mode: NO network calls, deterministic stub answers.
# Reports produced this way are labelled and are NOT a real agent run.
LLM_OFFLINE_MODE=false

# --- Target admission policy (SSRF boundary) --------------------------------
# The agent resolves the hostname you give it and drives a real browser at it,
# following redirects on its own, so the target URL is a server-side request
# forgery surface. Every navigation - including every redirect hop - is checked
# against the rules below. See target_policy.py.
#
# Permit loopback/private/link-local targets such as http://localhost:3000.
# OFF by default. Cloud instance metadata endpoints (169.254.169.254,
# metadata.google.internal, ...) stay blocked even when this is on: they return
# credential material and are never a valid test target.
ALLOW_PRIVATE_TARGETS=false
# Ignore TLS certificate errors. OFF by default - a broken chain on a test
# target may be an interception, and accepting it means typing credentials into
# whatever answered. Turn on only for a self-signed staging certificate.
ALLOW_INSECURE_TLS=false
# Operator allowlist of testable hosts. Empty means "any public host".
# Entries may be an exact host, a *.example.com wildcard, or a CIDR block.
# An allowlist narrows what is reachable; it never relaxes the address rules.
# TARGET_ALLOWLIST=*.staging.example.com,10.0.0.0/8
# Resolve hostnames and classify every returned address before navigating.
# Leave on: this is what catches DNS rebinding.
TARGET_RESOLVE_DNS=true

# --- Safe mode (destructive actions) ----------------------------------------
# The agent performs each action twice if nothing stops it: once while
# exploring and again when the generated test runs. Safe mode blocks payment,
# checkout, delete, account cancellation, password reset, outbound email and
# other irreversible submissions during BOTH phases. See safe_actions.py.
SAFE_MODE=true
# Categories to authorise while keeping safe mode on. Use only against a
# throwaway environment. Valid values: payment, checkout, delete,
# account_cancellation, password_reset, email_send, irreversible_submit
# AUTHORIZED_DESTRUCTIVE_ACTIONS=checkout,payment

# --- LLM cost controls ------------------------------------------------------
# Compile simple flows without calling a model at all. A flow whose every step
# resolved to a validated locator gains nothing from codegen.
PREFER_DETERMINISTIC_CODEGEN=true
# Cache discovery and selector answers, keyed by URL plus a DOM fingerprint,
# so a re-run over an unchanged page costs nothing and a changed page is
# re-asked.
LLM_CACHE_ENABLED=true
LLM_CACHE_MAX_ENTRIES=512

# --- Crawl strategy ---------------------------------------------------------
# Visit the highest-risk surface first (auth, checkout, cart, account, search)
# instead of crawling in link order. The budget is small, so ordering decides
# what gets tested at all.
CRAWL_ADAPTIVE=true
# Expand menus, tabs, accordions and dialogs so single-page applications
# reveal controls a link-only crawl never sees. Destructive controls are
# never clicked, whatever this is set to.
CRAWL_INTERACT=true
CRAWL_MAX_INTERACTIONS_PER_PAGE=6
CRAWL_MAX_SECONDS=240

# --- Execution reliability --------------------------------------------------
# Re-run a failed flow once, with jitter, when the failure looks timing
# dependent or the flow is high risk. A flow that fails then passes is
# reported as FLAKY, never as passing.
RERUN_FAILED_FLOWS=true
RERUN_JITTER_MS=750

# --- Operational limits -----------------------------------------------------
MAX_CONTEXTS_PER_RUN=4
# Concurrent runs against a single host. More than one is a load test.
PER_TARGET_CONCURRENCY=1
# Navigations per second against a single host. Parallel flow execution stays
# off unless this is set, whatever ENABLE_PARALLEL_EXECUTION says.
TARGET_RATE_LIMIT_PER_S=4.0
RUN_TIME_BUDGET_S=1800

# --- Visual baseline identity -----------------------------------------------
# A baseline is only a valid reference for a capture taken under the same
# conditions. Environment, locale, theme, viewport, browser major version and
# masking rules all key the baseline; the build id is recorded but does not,
# because a baseline exists to be compared across builds.
VISUAL_ENVIRONMENT=default
# VISUAL_BUILD_ID=
VISUAL_LOCALE=en-US
VISUAL_TIMEZONE=UTC
# Block analytics, ads and chat widgets before capture. The single largest
# source of false-positive visual diffs.
VISUAL_BLOCK_THIRD_PARTY=true
# Extra CSS selectors to mask, on top of the built-in dynamic-content rules
# (prices, dates, avatars, banners, carousels, toasts).
# VISUAL_MASK_SELECTORS=.live-price,.promo-banner
# Seed a fixed clock and RNG so "2 minutes ago" renders identically every run.
VISUAL_FREEZE_TIME=true

# --- Feature flags ----------------------------------------------------------
ENABLE_PRD_GAP_ANALYSIS=false
ENABLE_INTENT_BIAS=true
ENABLE_PARALLEL_EXECUTION=false
ENABLE_REGRESSION_RADAR=true
ENABLE_VISUAL_DIFF=true

# --- Crawl / execution ------------------------------------------------------
CRAWL_MAX_PAGES=12
CRAWL_MAX_DEPTH=2
HEADLESS=true
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=900
TEST_TIMEOUT_S=90
MAX_PARALLEL_FLOWS=3

# --- Visual regression ------------------------------------------------------
VISUAL_DIFF_THRESHOLD=0.02
VISUAL_PIXEL_TOLERANCE=24

# --- Service ----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO
